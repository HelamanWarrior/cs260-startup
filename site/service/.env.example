# Copy to .env for LOCAL DEVELOPMENT only. Never commit the real .env.
#
# Non-secret config: fine to keep as a plain env var.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Secret: the Gemini API key -------------------------------------------
# Preferred (production): mount the key as a file and point to it. The service
# reads GEMINI_API_KEY_FILE first (see secrets.js). With Docker Compose secrets
# the file lives at /run/secrets/<name>:
#
#   GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
#
# Fallback (local dev convenience): set the raw value instead.
GEMINI_API_KEY=your-key-here
